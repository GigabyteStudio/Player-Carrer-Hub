<%- include('partials/header', { title }) %>
    <%- include('partials/navbar') %>

        <main class="container">
            <section class="page-header">
                <h1>Editar Temporada</h1>
                <p>Altere os dados da temporada.</p>
            </section>

            <section class="form-card">
                <form action="/gerenciar/temporadas/editar/<%= season.id %>" method="POST" class="form-grid">
                    <div class="form-group">
                        <label>Nome</label>
                        <input type="text" name="name" value="<%= season.name %>" required>
                    </div>

                    <div class="form-group">
                        <label>Início</label>
                        <input type="date" name="start_date" value="<%= season.start_date || '' %>">
                    </div>

                    <div class="form-group">
                        <label>Fim</label>
                        <input type="date" name="end_date" value="<%= season.end_date || '' %>">
                    </div>

                    <div class="form-group">
                        <label>Temporada atual?</label>
                        <select name="is_current">
                            <option value="">Não</option>
                            <option value="1" <%=season.is_current ? 'selected' : '' %>>Sim</option>
                        </select>
                    </div>

                    <button type="submit" class="btn-primary">Salvar alterações</button>
                </form>
            </section>
        </main>

        <%- include('partials/footer') %>