<%- include('partials/header', { title }) %>
<%- include('partials/navbar') %>
<link rel="stylesheet" href="/css/pages-v2.css">
<link rel="stylesheet" href="/css/records-v2.css">
<main class="container pch-inner-page"><div class="pch-page-heading"><div><div class="pch-overline">DESENVOLVIMENTO</div><h1>Evolução</h1><p>Atributos atuais e histórico completo de progressão.</p></div><a class="pch-primary-action" href="/registrar/evolucao">+ Registrar atributos</a></div><section class="pch-panel"><div class="pch-panel-title"><div><h3>Atributos atuais</h3><p>Último registro da carreira.</p></div><span class="pch-count"><%= history.length %> registros</span></div><% if(latestAttributes){%><div class="pch-current-overall"><span>OVERALL</span><strong><%= latestAttributes.overall ?? '—' %></strong><small><%= formatDate(latestAttributes.date) %></small></div><div class="pch-attribute-grid"><% attributeList.slice(1).forEach(a=>{%><div class="pch-attribute-tile"><span><%= a.label %></span><strong><%= latestAttributes[a.key] ?? '—' %></strong><small><%= a.short %></small></div><%})%></div><%}else{%><div class="pch-list-empty">Nenhum registro de evolução cadastrado ainda.</div><%}%></section><section class="pch-panel pch-below"><div class="pch-panel-title"><div><h3>Linha do tempo</h3><p>Comparação de cada registro com o anterior.</p></div></div><%if(history.length){%><div class="pch-history-scroll"><div class="pch-history"><%history.forEach((r,i)=>{const prev=i>0?history[i-1]:null;%><article class="pch-history-item"><div class="pch-history-head"><strong><%= r.season_name || 'Sem temporada' %></strong><small><%= formatDate(r.date) %></small></div><div class="pch-inline-actions"><a href="/registrar/evolucao/editar/<%= r.id %>">Editar</a><form method="post" action="/registrar/evolucao/excluir/<%= r.id %>" onsubmit="return confirm('Excluir esta evolução?')"><button class="pch-danger" type="submit">Excluir</button></form></div><%attributeList.forEach(a=>{const val=r[a.key];const difference=prev && val != null && prev[a.key] != null ? Number(val)-Number(prev[a.key]) : null;%><div class="pch-history-row"><span><%= a.label %></span><div><strong><%= val ?? '—' %></strong><%if(difference !== null){%><small class="<%= difference>0?'pch-positive':difference<0?'pch-negative':'pch-neutral' %>"><%= difference>0?'+':'' %><%= difference %></small><%}%></div></div><%})%></article><%})%></div></div><%}else{%><div class="pch-list-empty">Nenhum registro para exibir na linha do tempo cadastrado ainda.</div><%}%></section></main>
<%- include('partials/footer') %>
