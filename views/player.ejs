<%- include('partials/header', { title }) %>
<%- include('partials/navbar') %>
<link rel="stylesheet" href="/css/home-complete-v2.css">
<main class="container pch-dashboard">
  <header class="pch-page-heading">
    <div>
      <div class="pch-overline">PAINEL DO JOGADOR</div>
      <h1>Visão geral</h1>
      <p>Resumo da carreira e desempenho em campo.</p>
    </div>
  </header>
  <% if (!player) { %>
  <section class="pch-empty">
    <h2>Nenhum jogador cadastrado</h2><a class="pch-primary-action" href="/cadastro">Cadastrar jogador</a>
  </section>
  <% } else { %>
  <section class="pch-player-hero">
    <div class="pch-hero-copy">
      <div class="pch-player-title-line"><% if (player.nationality_flag) { %><img class="pch-player-title-flag" src="<%= player.nationality_flag %>" alt=""><% } %><h2><%= player.name %></h2>
      </div>
      <div class="pch-player-subline"><span><%= player.nationality_name || 'Nacionalidade não definida' %></span><span class="pch-separator">·</span><span><%= player.age ?? '—' %> anos</span><% if(player.positions){ %><span class="pch-separator">·</span><span class="pch-position"><%= player.positions.split(',').map(p=>p.trim()).join(' - ') %></span><% } %></div>
      <div class="pch-player-metadata">
        <div class="pch-club-field"><small>CLUBE ATUAL</small><strong class="pch-club-name"><% if(currentTransfer?.club_logo){ %><img class="pch-club-logo" src="<%= currentTransfer.club_logo %>" alt=""><% } %><%= currentTransfer?.club_name || 'Não definido' %></strong></div>
        <div><small>NO CLUBE DESDE</small><strong><%= currentTransfer?.date ? formatDate(currentTransfer.date) : '—' %></strong></div>
        <div><small>CAMISA</small><strong><%= player.shirt_number ? '#'+player.shirt_number : '—' %></strong></div>
        <div><small>PÉ PREFERIDO</small><strong><%= player.preferred_foot || '—' %></strong></div>
        <div><small>VALOR DE MERCADO</small><strong><%= marketSummary.current != null ? formatMoney(marketSummary.current) : '—' %></strong></div>
        <% if(player.sponsor){ %><div><small>PATROCINADOR</small><strong><%= player.sponsor %></strong></div><% } %>
      </div>
    </div>
    <div class="pch-hero-photo-frame"><% if(player.photo){ %><% const x=Number(player.photo_position_x ?? 50),y=Number(player.photo_position_y ?? 50),z=Number(player.photo_zoom ?? 1); %><img class="pch-hero-photo" src="<%= player.photo %>" alt="Foto do jogador" data-x="<%= x %>" data-y="<%= y %>" data-zoom="<%= z %>"><% }else{ %><div class="pch-hero-no-photo">SEM FOTO</div><% } %></div>
    <div class="pch-hero-overall"><strong><%= latestAttributes?.overall ?? '—' %></strong><span>OVERALL</span></div>
    <a href="/cadastro" class="pch-hero-edit">Editar perfil ↗</a>
  </section>
  <section class="pch-profile-minis">
    <div><small>ALTURA</small><strong><%= player.height ? (Number(player.height)/100).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+' m' : '—' %></strong></div>
    <div><small>PESO</small><strong><%= player.weight ? player.weight+' kg' : '—' %></strong></div>
    <div><small>FINTAS</small><span class="pch-stars" aria-label="<%= player.skill_moves ?? 0 %> de 5 estrelas"><% for(let i=1;i<=5;i++){ %><span class="<%= i<=Number(player.skill_moves || 0) ? 'on' : '' %>">★</span><% } %></span></div>
    <div><small>PERNA RUIM</small><span class="pch-stars" aria-label="<%= player.weak_foot ?? 0 %> de 5 estrelas"><% for(let i=1;i<=5;i++){ %><span class="<%= i<=Number(player.weak_foot || 0) ? 'on' : '' %>">★</span><% } %></span></div>
  </section>
  <div class="pch-section-divider"><span>RESUMO DA CARREIRA</span></div>
  <section class="pch-stat-grid">
    <div class="pch-stat-card"><span>Partidas</span><strong><%= careerTotals.games || 0 %></strong><small>registradas na carreira</small></div>
    <div class="pch-stat-card"><span>Gols</span><strong><%= careerTotals.goals || 0 %></strong><small><em><%= careerTotals.goals_average %></em> por partida</small></div>
    <div class="pch-stat-card"><span>Assistências</span><strong><%= careerTotals.assists || 0 %></strong><small><em><%= careerTotals.assists_average %></em> por partida</small></div>
    <div class="pch-stat-card"><span>Nota média</span><strong><%= careerTotals.average_rating %></strong><small>média ponderada por partidas</small></div>
  </section>
  <div class="pch-dashboard-grid">
    <section class="pch-panel">
      <div class="pch-panel-title">
        <div>
          <h3>Dentro de campo</h3>
          <p>Desempenho por competição</p>
        </div><a href="/estatisticas">Ver estatísticas ↗</a>
      </div>
      <% if(careerStats.length){ %><div class="pch-table-scroll">
        <table class="pch-stat-table">
          <thead>
            <tr>
              <th>COMPETIÇÃO</th>
              <th>J</th>
              <th>G</th>
              <th>A</th>
              <th>NOTA</th>
            </tr>
          </thead>
          <tbody>
            <% careerStats.forEach(c=>{ %><tr>
              <td><span class="pch-comp-name"><% if(c.competition_logo){ %><img src="<%= c.competition_logo %>" alt=""><% } %><%= c.competition_name %></span></td>
              <td><%= c.games %></td>
              <td><%= c.goals %></td>
              <td><%= c.assists %></td>
              <td><%= c.average_rating == null ? '—' : Number(c.average_rating).toFixed(2).replace('.',',') %></td>
            </tr><% }) %>
            <tr class="pch-total-row">
              <td>Total</td>
              <td><%= careerTotals.games %></td>
              <td><%= careerTotals.goals %></td>
              <td><%= careerTotals.assists %></td>
              <td><%= careerTotals.average_rating %></td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="pch-table-foot"><%= careerTotals.goals_average %> gol/jogo · <%= careerTotals.assists_average %> assistência/jogo</p><% }else{ %><div class="pch-panel-empty">Nenhuma estatística registrada.</div><% } %>
    </section>
    <section class="pch-panel">
      <div class="pch-panel-title">
        <div>
          <h3>Evolução do overall</h3>
          <p>Histórico de atributos</p>
        </div><a href="/evolucao">Ver evolução ↗</a>
      </div>
      <div class="pch-graph-summary"><span>Mínimo <strong><%= overallSummary.min ?? '—' %></strong></span><span>Máximo <strong><%= overallSummary.max ?? '—' %></strong></span></div>
      <div class="pch-interactive-chart" id="pchOverallGraph" data-points="<%= JSON.stringify(overallHistory.map(h=>({date:h.date,season:h.season_name,value:Number(h.overall)}))) %>" data-kind="overall"></div>
    </section>
  </div>
  <div class="pch-secondary-grid">
    <section class="pch-panel">
      <div class="pch-panel-title">
        <div>
          <h3>Atributos atuais</h3>
          <p>Último registro</p>
        </div><a href="/evolucao">Ver evolução ↗</a>
      </div><% if(latestAttributes){ %><div class="pch-attributes"><% (player.positions?.split(',').map(p=>p.trim()).includes('GOL') ? [['MER','gk_diving'],['MAN','gk_handling'],['CHU','gk_kicking'],['REF','gk_reflexes'],['VEL','gk_speed'],['POS','gk_positioning']] : [['RIT','pace'],['FIN','shooting'],['PAS','passing'],['CON','dribbling'],['DEF','defending'],['FÍS','physical']]).forEach(([label,key])=>{ %><div><span><%= label %></span><strong><%= latestAttributes[key] ?? '—' %></strong></div><% }) %></div><% }else{ %><div class="pch-panel-empty">Nenhum atributo registrado.</div><% } %>
    </section>
    <section class="pch-panel">
      <div class="pch-panel-title">
        <div>
          <h3>Conquistas</h3>
          <p>Troféus acumulados</p>
        </div><a href="/trofeus">Ver todos ↗</a>
      </div><% if(trophies.length){ %><div class="pch-trophy-list"><% trophies.slice(0,5).forEach(t=>{ %><div><% if(t.image){ %><img src="<%= t.image %>" alt=""><% } %><span><%= t.name %></span><strong>×<%= t.quantity %></strong></div><% }) %></div><% }else{ %><div class="pch-panel-empty">Nenhuma conquista registrada.</div><% } %>
    </section>
  </div>
  <div class="pch-secondary-grid pch-final-panels">
    <section class="pch-panel">
      <div class="pch-panel-title">
        <div>
          <h3>Valor de mercado</h3>
          <p>Histórico em euros</p>
        </div><a href="/evolucao">Ver evolução ↗</a>
      </div>
      <div class="pch-graph-summary"><span>Valor atual <strong><%= formatMoney(marketSummary.current) %></strong></span><span>Maior valor <strong><%= formatMoney(marketSummary.max) %></strong></span></div>
      <div class="pch-interactive-chart" id="pchMarketGraph" data-points="<%= JSON.stringify(marketHistory.map(h=>({date:h.date,season:h.season_name,value:Number(h.market_value)}))) %>" data-kind="market"></div>
    </section>
    <section class="pch-panel">
      <div class="pch-panel-title">
        <div>
          <h3>Campeonatos</h3>
          <p>Histórico de participações</p>
        </div><a href="/estatisticas">Ver estatísticas ↗</a>
      </div><% if(campaigns.length){ %><div class="pch-campaign-scroll">
        <table class="pch-stat-table">
          <thead>
            <tr>
              <th>TEMPORADA</th>
              <th>COMPETIÇÃO</th>
              <th>TIME</th>
              <th>CATEGORIA</th>
              <th>POSIÇÃO</th>
            </tr>
          </thead>
          <tbody><% campaigns.forEach(c=>{ %><tr>
              <td><%= c.season_name %></td>
              <td><span class="pch-comp-name"><% if(c.competition_logo){ %><img src="<%= c.competition_logo %>" alt=""><% } %><%= c.competition_name %></span></td>
              <td><span class="pch-comp-name"><% if(c.club_logo){ %><img src="<%= c.club_logo %>" alt=""><% } %><%= c.club_name %></span></td>
              <td><%= c.competition_category || '—' %></td>
              <td><%= c.final_position || '—' %></td>
            </tr><% }) %></tbody>
        </table>
      </div><% }else{ %><div class="pch-panel-empty">Nenhuma campanha cadastrada.</div><% } %>
    </section>
  </div>
  <% } %>
</main>
<script src="/js/home-graphs-v2.js" defer></script>
<%- include('partials/footer') %>