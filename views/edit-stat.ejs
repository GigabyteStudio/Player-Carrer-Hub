<%- include('partials/header', { title }) %>
    <%- include('partials/navbar') %>

        <main class="container">
            <section class="page-header">
                <h1>Editar Estatística</h1>
                <p>Altere os números da campanha.</p>
            </section>

            <section class="form-card">
                <form action="/gerenciar/estatisticas/editar/<%= stat.id %>" method="POST" class="form-grid">
                    <div class="form-group">
                        <label>Campanha</label>
                        <input type="text"
                            value="<%= stat.season_name %> • <%= stat.club_name %> • <%= stat.competition_name %>"
                            disabled>
                    </div>

                    <div class="form-group">
                        <label>Jogos</label>
                        <input type="number" name="games" value="<%= stat.games %>" min="0">
                    </div>

                    <div class="form-group">
                        <label>Gols</label>
                        <input type="number" name="goals" value="<%= stat.goals %>" min="0">
                    </div>

                    <div class="form-group">
                        <label>Assistências</label>
                        <input type="number" name="assists" value="<%= stat.assists %>" min="0">
                    </div>

                    <div class="form-group">
                        <label>Amarelos</label>
                        <input type="number" name="yellow_cards" value="<%= stat.yellow_cards %>" min="0">
                    </div>

                    <div class="form-group">
                        <label>2º Amarelo</label>
                        <input type="number" name="second_yellow_cards" value="<%= stat.second_yellow_cards %>" min="0">
                    </div>

                    <div class="form-group">
                        <label>Vermelhos</label>
                        <input type="number" name="red_cards" value="<%= stat.red_cards %>" min="0">
                    </div>

                    <div class="form-group">
                        <label>Nota Média</label>
                        <input type="number" name="average_rating" value="<%= stat.average_rating || '' %>" min="0"
                            max="10" step="0.01">
                    </div>

                    <div class="form-group">
                        <label>Artilheiro?</label>
                        <select name="top_scorer">
                            <option value="">Não</option>
                            <option value="1" <%=stat.top_scorer ? 'selected' : '' %>>Sim</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Garçom?</label>
                        <select name="top_assister">
                            <option value="">Não</option>
                            <option value="1" <%=stat.top_assister ? 'selected' : '' %>>Sim</option>
                        </select>
                    </div>

                    <button type="submit" class="btn-primary">Salvar alterações</button>
                </form>
            </section>
        </main>

        <%- include('partials/footer') %>