<%- include('partials/header', { title }) %>
    <%- include('partials/navbar') %>

        <main class="container">
            <section class="page-header">
                <h1>Editar Competição</h1>
                <p>Altere os dados da competição.</p>
            </section>

            <section class="form-card">
                <form action="/gerenciar/competicoes/editar/<%= competition.id %>" method="POST"
                    enctype="multipart/form-data" class="form-grid">
                    <div class="form-group">
                        <label>Nome</label>
                        <input type="text" name="name" value="<%= competition.name %>" required>
                    </div>

                    <div class="form-group">
                        <label>Categoria</label>
                        <select name="category" required>
                            <option value="">Selecione</option>
                            <option value="Liga" <%=competition.category==='Liga' ? 'selected' : '' %>>Liga</option>
                            <option value="Copa" <%=competition.category==='Copa' ? 'selected' : '' %>>Copa</option>
                            <option value="Copa da Liga" <%=competition.category==='Copa da Liga' ? 'selected' : '' %>
                                >Copa da Liga</option>
                            <option value="Continental" <%=competition.category==='Continental' ? 'selected' : '' %>
                                >Continental</option>
                            <option value="Amistoso" <%=competition.category==='Amistoso' ? 'selected' : '' %>>Amistoso
                            </option>
                            <option value="Seleção" <%=competition.category==='Seleção' ? 'selected' : '' %>>Seleção
                            </option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>País/Região</label>
                        <select name="country_id">
                            <option value="">Selecione</option>
                            <% countries.forEach(country=> { %>
                                <option value="<%= country.id %>" <%=competition.country_id===country.id ? 'selected'
                                    : '' %>>
                                    <%= country.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Logo atual</label>
                        <% if (competition.logo) { %>
                            <img src="<%= competition.logo %>" class="table-logo">
                            <% } else { %>
                                <span>-</span>
                                <% } %>
                    </div>

                    <div class="form-group">
                        <label>Nova logo</label>
                        <input type="hidden" name="current_logo" value="<%= competition.logo || '' %>">
                        <input type="file" name="logo" accept="image/*">
                    </div>

                    <button type="submit" class="btn-primary">Salvar alterações</button>
                </form>
            </section>
        </main>

        <%- include('partials/footer') %>