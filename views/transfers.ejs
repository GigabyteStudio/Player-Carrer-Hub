<%- include('partials/header', { title }) %>
<%- include('partials/navbar') %>
<link rel="stylesheet" href="/css/pages-v2.css">
<link rel="stylesheet" href="/css/records-v2.css">
<main class="container pch-inner-page"><div class="pch-page-heading"><div><div class="pch-overline">CARREIRA</div><h1>Transferências</h1><p>Histórico de clubes, valores e contratos.</p></div><a class="pch-primary-action" href="/registrar/transferencias">+ Registrar transferência</a></div><section class="pch-panel"><div class="pch-panel-title"><div><h3>Histórico de transferências</h3><p>Registros da carreira em ordem cronológica inversa.</p></div><span class="pch-count"><%= transfers.length %> registros</span></div>
<% if (transfers.length) { %><div class="pch-table-scroll"><table class="pch-stat-table pch-detail-table"><thead><tr><th>Temporada</th><th>Data</th><th>Clube de origem</th><th>Clube de destino</th><th>Valor de mercado</th><th>Valor pago</th><th>Contrato até</th><th class="pch-transfer-action-col">Ações</th></tr></thead><tbody>
<% transfers.forEach(t => { %><tr><td><strong><%= t.season_name %></strong></td><td><%= formatDate(t.date) %></td><td><span class="pch-team"><% if(t.from_club_logo){%><img alt="" src="<%= t.from_club_logo %>"><%}%><%= t.from_club_name || 'Início da carreira' %></span></td><td><span class="pch-team"><% if(t.to_club_logo){%><img alt="" src="<%= t.to_club_logo %>"><%}%><%= t.to_club_name %></span></td><td><%= formatMoney(t.market_value) %></td><td class="pch-accent"><%= formatMoney(t.transfer_fee) %></td><td><%= formatDate(t.contract_until) %></td><td class="pch-transfer-action-col"><form class="pch-transfer-delete" method="post" action="/registrar/transferencias/excluir/<%= t.id %>" onsubmit="return confirm('Excluir esta transferência do histórico? Esta ação não exclui os clubes cadastrados.')"><button type="submit" class="pch-transfer-delete-btn" aria-label="Excluir transferência">Excluir</button></form></td></tr><% }) %></tbody></table></div><% } else { %><div class="pch-list-empty">Nenhuma transferência cadastrado ainda.</div><% } %></section></main>
<%- include('partials/footer') %>
