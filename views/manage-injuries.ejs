<%- include('partials/header', { title }) %>
    <%- include('partials/navbar') %>

        <main class="container">
            <section class="page-header">
                <h1>Lesões</h1>
                <p>Registre lesões, dias afastado e jogos perdidos.</p>
            </section>

            <section class="form-card">
                <h2>Adicionar Lesão</h2>

                <form action="/gerenciar/lesoes/adicionar" method="POST" class="form-grid">
                    <div class="form-group">
                        <label>Temporada</label>
                        <select name="season_id" required>
                            <option value="">Selecione</option>
                            <% seasons.forEach(season=> { %>
                                <option value="<%= season.id %>">
                                    <%= season.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Nome da Lesão</label>
                        <input type="text" name="injury_name" placeholder="Entorse no tornozelo" required>
                    </div>

                    <div class="form-group">
                        <label>Data da Lesão</label>
                        <input type="date" name="injury_date">
                    </div>

                    <div class="form-group">
                        <label>Dias Lesionado</label>
                        <input type="number" name="days_injured" min="0" value="0">
                    </div>

                    <div class="form-group">
                        <label>Jogos Perdidos</label>
                        <input type="number" name="games_missed" min="0" value="0">
                    </div>

                    <button type="submit" class="btn-primary">Adicionar</button>
                </form>
            </section>

            <section class="table-card">
                <h2>Lesões cadastradas</h2>

                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Temporada</th>
                            <th>Lesão</th>
                            <th>Data da Lesão</th>
                            <th>Dias Lesionado</th>
                            <th>Jogos Perdidos</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% injuries.forEach(injury=> { %>
                            <tr>
                                <td>
                                    <%= injury.season_name %>
                                </td>
                                <td>
                                    <%= injury.injury_name %>
                                </td>
                                <td>
                                    <%= formatDate(injury.injury_date) %>
                                </td>
                                <td>
                                    <%= injury.days_injured || 0 %>
                                </td>
                                <td>
                                    <%= injury.games_missed || 0 %>
                                </td>

                                <td class="actions-cell">
                                    <a class="btn-small" href="/gerenciar/lesoes/editar/<%= injury.id %>">Editar</a>

                                    <form action="/gerenciar/lesoes/excluir/<%= injury.id %>" method="POST"
                                        onsubmit="return confirm('Excluir esta lesão?')">
                                        <button type="submit" class="btn-danger">Excluir</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </section>
        </main>

        <%- include('partials/footer') %>