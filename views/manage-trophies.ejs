<%- include('partials/header', { title }) %>
    <%- include('partials/navbar') %>

        <main class="container">
            <section class="page-header">
                <h1>Troféus</h1>
                <p>Cadastre tipos de troféus e registre conquistas.</p>
            </section>

            <section class="form-card">
                <h2>Adicionar Tipo de Troféu</h2>

                <form action="/gerenciar/trofeus/adicionar-trofeu" method="POST" enctype="multipart/form-data"
                    class="form-grid">
                    <div class="form-group">
                        <label>Nome</label>
                        <input type="text" name="name" placeholder="UEFA Europa League, Artilheiro..." required>
                    </div>

                    <div class="form-group">
                        <label>Peso / Importância</label>
                        <input type="number" name="importance" min="1" value="1">
                    </div>

                    <div class="form-group">
                        <label>Imagem</label>
                        <input type="file" name="image" accept="image/*">
                    </div>

                    <button type="submit" class="btn-primary">Adicionar Troféu</button>
                </form>
            </section>

            <section class="form-card">
                <h2>Adicionar Conquista</h2>

                <form action="/gerenciar/trofeus/adicionar-conquista" method="POST" class="form-grid">
                    <div class="form-group">
                        <label>Troféu</label>
                        <select name="trophy_id" required>
                            <option value="">Selecione</option>
                            <% trophies.forEach(trophy=> { %>
                                <option value="<%= trophy.id %>">
                                    <%= trophy.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Temporada</label>
                        <select name="season_id">
                            <option value="">Nenhuma</option>
                            <% seasons.forEach(season=> { %>
                                <option value="<%= season.id %>">
                                    <%= season.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Time/Seleção</label>
                        <select name="club_id">
                            <option value="">Nenhum</option>
                            <% clubs.forEach(club=> { %>
                                <option value="<%= club.id %>">
                                    <%= club.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Competição</label>
                        <select name="competition_id">
                            <option value="">Nenhuma</option>
                            <% competitions.forEach(competition=> { %>
                                <option value="<%= competition.id %>">
                                    <%= competition.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Info extra</label>
                        <input type="text" name="extra_info" placeholder="7 gols, Jogador da Semana...">
                    </div>

                    <button type="submit" class="btn-primary">Adicionar Conquista</button>
                </form>
            </section>

            <section class="table-card">
                <h2>Tipos de Troféus</h2>

                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Imagem</th>
                            <th>Nome</th>
                            <th>Peso</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% trophies.forEach(trophy=> { %>
                            <tr>
                                <td>
                                    <% if (trophy.image) { %>
                                        <img src="<%= trophy.image %>" class="table-logo">
                                        <% } else { %>
                                            -
                                            <% } %>
                                </td>

                                <td>
                                    <%= trophy.name %>
                                </td>
                                <td>
                                    <%= trophy.importance %>
                                </td>

                                <td class="actions-cell">
                                    <a class="btn-small"
                                        href="/gerenciar/trofeus/editar-trofeu/<%= trophy.id %>">Editar</a>

                                    <form action="/gerenciar/trofeus/excluir-trofeu/<%= trophy.id %>" method="POST"
                                        onsubmit="return confirm('Excluir este troféu e todas as conquistas dele?')">
                                        <button type="submit" class="btn-danger">Excluir</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </section>

            <section class="table-card">
                <h2>Conquistas cadastradas</h2>

                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Troféu</th>
                            <th>Temporada</th>
                            <th>Time</th>
                            <th>Competição</th>
                            <th>Info extra</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% entries.forEach(entry=> { %>
                            <tr>
                                <td>
                                    <%= entry.trophy_name %>
                                </td>
                                <td>
                                    <%= entry.season_name || '-' %>
                                </td>
                                <td>
                                    <%= entry.club_name || '-' %>
                                </td>
                                <td>
                                    <%= entry.competition_name || '-' %>
                                </td>
                                <td>
                                    <%= entry.extra_info || '-' %>
                                </td>

                                <td class="actions-cell">
                                    <a class="btn-small"
                                        href="/gerenciar/trofeus/editar-conquista/<%= entry.id %>">Editar</a>

                                    <form action="/gerenciar/trofeus/excluir-conquista/<%= entry.id %>" method="POST"
                                        onsubmit="return confirm('Excluir esta conquista?')">
                                        <button type="submit" class="btn-danger">Excluir</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </section>
        </main>

        <%- include('partials/footer') %>