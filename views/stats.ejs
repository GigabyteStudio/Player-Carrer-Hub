<%- include('partials/header', { title }) %>
<%- include('partials/navbar') %>
<link rel="stylesheet" href="/css/pages-v2.css">
<link rel="stylesheet" href="/css/records-v2.css">
<main class="container pch-inner-page"><div class="pch-page-heading"><div><div class="pch-overline">DESEMPENHO</div><h1>Estatísticas</h1><p>Números por competição e por campanha.</p></div><a class="pch-primary-action" href="/registrar/estatisticas">+ Registrar estatísticas</a></div><% const f=(n)=> Number(n||0).toLocaleString('pt-BR'); const r=(n)=> n == null || n === '-' ? '—' : Number(n).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}); %><div class="pch-stat-grid"><div class="pch-stat-card"><span>Partidas</span><strong><%= f(careerTotals.games) %></strong><small>toda a carreira</small></div><div class="pch-stat-card"><span>Gols</span><strong><%= f(careerTotals.goals) %></strong><small><%= r(careerTotals.goals_average) %> por jogo</small></div><div class="pch-stat-card"><span>Assistências</span><strong><%= f(careerTotals.assists) %></strong><small><%= r(careerTotals.assists_average) %> por jogo</small></div><div class="pch-stat-card"><span>Nota média</span><strong><%= r(careerTotals.average_rating) %></strong><small>média registrada</small></div></div>
<section class="pch-panel pch-below"><div class="pch-panel-title"><div><h3>Estatísticas por competição</h3><p>Totais acumulados durante a carreira.</p></div></div><% if(careerStats.length){%><div class="pch-table-scroll"><table class="pch-stat-table pch-detail-table"><thead><tr><th>Competição</th><th>J</th><th>G</th><th>G/J</th><th>A</th><th>A/J</th><th>CA</th><th>2º CA</th><th>CV</th><th>Nota</th><th>Artilh.</th><th>Garçom</th></tr></thead><tbody><% careerStats.forEach(s=>{%><tr><td><span class="pch-team"><%if(s.competition_logo){%><img src="<%= s.competition_logo %>" alt=""><%}%><strong><%= s.competition_name %></strong></span></td><td><%= f(s.games) %></td><td class="pch-accent"><%= f(s.goals) %></td><td><%= s.games ? r(s.goals/s.games) : '—' %></td><td><%= f(s.assists) %></td><td><%= s.games ? r(s.assists/s.games) : '—' %></td><td><%= f(s.yellow_cards) %></td><td><%= f(s.second_yellow_cards) %></td><td><%= f(s.red_cards) %></td><td><span class="pch-rating-chip"><%= r(s.average_rating) %></span></td><td><% if(Number(s.top_scorer)===1){ %><span class="pch-boolean-check" title="Confirmado">✓</span><% } else if(Number(s.top_scorer)>1){ %><%= f(s.top_scorer) %><% } else { %>—<% } %></td><td><% if(Number(s.top_assister)===1){ %><span class="pch-boolean-check" title="Confirmado">✓</span><% } else if(Number(s.top_assister)>1){ %><%= f(s.top_assister) %><% } else { %>—<% } %></td></tr><%})%></tbody><tfoot><tr><td>Total</td><td><%= f(careerTotals.games) %></td><td><%= f(careerTotals.goals) %></td><td><%= r(careerTotals.goals_average) %></td><td><%= f(careerTotals.assists) %></td><td><%= r(careerTotals.assists_average) %></td><td><%= f(careerTotals.yellow_cards) %></td><td><%= f(careerTotals.second_yellow_cards) %></td><td><%= f(careerTotals.red_cards) %></td><td><%= r(careerTotals.average_rating) %></td><td><%= f(careerTotals.top_scorer) %></td><td><%= f(careerTotals.top_assister) %></td></tr></tfoot></table></div><%}else{%><div class="pch-list-empty">Nenhum dado estatístico cadastrado ainda.</div><%}%></section>
<section class="pch-panel pch-below"><div class="pch-panel-title"><div><h3>Estatísticas por campanha</h3><p>Filtre por temporada, clube, competição e categoria.</p></div></div><form action="/estatisticas" method="GET" class="pch-filters"><label>Temporada<select name="season_id"><option value="">Todas</option><%seasons.forEach(s=>{%><option value="<%= s.id %>" <%= String(selectedSeasonId)===String(s.id)?'selected':'' %>><%= s.name %></option><%})%></select></label><label>Clube<select name="club_id"><option value="">Todos</option><%clubs.forEach(c=>{%><option value="<%= c.id %>" <%= String(selectedClubId)===String(c.id)?'selected':'' %>><%= c.name %></option><%})%></select></label><label>Categoria<select name="category"><option value="">Todas</option><%categories.forEach(c=>{%><option value="<%= c.category %>" <%= selectedCategory===c.category?'selected':'' %>><%= c.category %></option><%})%></select></label><label>Competição<select name="competition_id"><option value="">Todas</option><%competitions.forEach(c=>{%><option value="<%= c.id %>" <%= String(selectedCompetitionId)===String(c.id)?'selected':'' %>><%= c.name %></option><%})%></select></label><button type="submit" class="pch-primary-action">Filtrar</button><a class="pch-clear-filter" href="/estatisticas">Limpar</a></form>
<%if(filteredStats.length){%><div class="pch-table-scroll"><table class="pch-stat-table pch-detail-table"><thead><tr><th>Temporada</th><th>Clube</th><th>Competição</th><th>J</th><th>G</th><th>G/J</th><th>A</th><th>A/J</th><th>CA</th><th>2º CA</th><th>CV</th><th>Nota</th><th>Artilh.</th><th>Garçom</th></tr></thead><tbody><%filteredStats.forEach(s=>{%><tr><td><%= s.season_name %></td><td><span class="pch-team"><%if(s.club_logo){%><img src="<%= s.club_logo %>" alt=""><%}%><%= s.club_name %></span></td><td><span class="pch-team"><%if(s.competition_logo){%><img src="<%= s.competition_logo %>" alt=""><%}%><%= s.competition_name %></span></td><td><%= f(s.games) %></td><td class="pch-accent"><%= f(s.goals) %></td><td><%= s.games?r(s.goals/s.games):'—' %></td><td><%= f(s.assists) %></td><td><%= s.games?r(s.assists/s.games):'—' %></td><td><%= f(s.yellow_cards) %></td><td><%= f(s.second_yellow_cards) %></td><td><%= f(s.red_cards) %></td><td><span class="pch-rating-chip"><%= r(s.average_rating) %></span></td><td><% if(Number(s.top_scorer)===1){ %><span class="pch-boolean-check" title="Confirmado">✓</span><% } else if(Number(s.top_scorer)>1){ %><%= f(s.top_scorer) %><% } else { %>—<% } %></td><td><% if(Number(s.top_assister)===1){ %><span class="pch-boolean-check" title="Confirmado">✓</span><% } else if(Number(s.top_assister)>1){ %><%= f(s.top_assister) %><% } else { %>—<% } %></td></tr><%})%></tbody><tfoot><tr><td colspan="3">Total do filtro</td><td><%= f(filteredTotals.games) %></td><td><%= f(filteredTotals.goals) %></td><td><%= r(filteredTotals.goals_average) %></td><td><%= f(filteredTotals.assists) %></td><td><%= r(filteredTotals.assists_average) %></td><td><%= f(filteredTotals.yellow_cards) %></td><td><%= f(filteredTotals.second_yellow_cards) %></td><td><%= f(filteredTotals.red_cards) %></td><td><%= r(filteredTotals.average_rating) %></td><td><%= f(filteredTotals.top_scorer) %></td><td><%= f(filteredTotals.top_assister) %></td></tr></tfoot></table></div><%}else{%><div class="pch-list-empty">Nenhum resultado para os filtros selecionados cadastrado ainda.</div><%}%></section></main>
<%- include('partials/footer') %>
