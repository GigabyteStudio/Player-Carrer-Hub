<%- include('partials/header', { title }) %>
    <%- include('partials/navbar') %>

        <main class="container">
            <section class="page-header">
                <h1>Transferências</h1>
                <p>Registre histórico de clubes, valores e contratos.</p>
            </section>

            <section class="form-card">
                <h2>Adicionar Transferência</h2>

                <form action="/gerenciar/transferencias/adicionar" method="POST" class="form-grid">
                    <div class="form-group">
                        <label>Temporada</label>
                        <select name="season_id" required>
                            <option value="">Selecione</option>
                            <% seasons.forEach(season=> { %>
                                <option value="<%= season.id %>">
                                    <%= season.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Data</label>
                        <input type="date" name="date" required>
                    </div>

                    <div class="form-group">
                        <label>Origem</label>
                        <select name="from_club_id">
                            <option value="">Sem clube / Início</option>
                            <% clubs.forEach(club=> { %>
                                <option value="<%= club.id %>">
                                    <%= club.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Destino</label>
                        <select name="to_club_id" required>
                            <option value="">Selecione</option>
                            <% clubs.forEach(club=> { %>
                                <option value="<%= club.id %>">
                                    <%= club.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Valor de Mercado</label>
                        <input type="number" name="market_value" min="0" placeholder="5000000">
                    </div>

                    <div class="form-group">
                        <label>Valor Pago</label>
                        <input type="number" name="transfer_fee" min="0" value="0">
                    </div>

                    <div class="form-group">
                        <label>Contrato até</label>
                        <input type="date" name="contract_until">
                    </div>

                    <button type="submit" class="btn-primary">Adicionar</button>
                </form>
            </section>

            <section class="table-card">
                <h2>Transferências cadastradas</h2>

                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Temporada</th>
                            <th>Data</th>
                            <th>Origem</th>
                            <th>Destino</th>
                            <th>Valor Mercado</th>
                            <th>Valor Pago</th>
                            <th>Contrato</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% transfers.forEach(transfer=> { %>
                            <tr>
                                <td>
                                    <%= transfer.season_name %>
                                </td>
                                <td>
                                    <%= formatDate(transfer.date) %>
                                </td>

                                <td>
                                    <% if (transfer.from_club_logo) { %>
                                        <img src="<%= transfer.from_club_logo %>" class="table-flag">
                                        <% } %>
                                            <%= transfer.from_club_name || '-' %>
                                </td>

                                <td>
                                    <% if (transfer.to_club_logo) { %>
                                        <img src="<%= transfer.to_club_logo %>" class="table-flag">
                                        <% } %>
                                            <%= transfer.to_club_name %>
                                </td>

                                <td>
                                    <%= formatMoney(transfer.market_value) %>
                                </td>
                                <td>
                                    <%= formatMoney(transfer.transfer_fee) %>
                                </td>
                                <td>
                                    <%= formatDate(transfer.contract_until) %>
                                </td>

                                <td class="actions-cell">
                                    <a class="btn-small"
                                        href="/gerenciar/transferencias/editar/<%= transfer.id %>">Editar</a>

                                    <form action="/gerenciar/transferencias/excluir/<%= transfer.id %>" method="POST"
                                        onsubmit="return confirm('Excluir esta transferência?')">
                                        <button type="submit" class="btn-danger">Excluir</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </section>
        </main>

        <%- include('partials/footer') %>