<%- include('partials/header', { title }) %>
    <%- include('partials/navbar') %>

        <main class="container">
            <section class="page-header">
                <h1>Estatísticas</h1>
                <p>Registre os números totais por campanha.</p>
            </section>

            <section class="form-card">
                <h2>Adicionar Estatística</h2>

                <form action="/gerenciar/estatisticas/adicionar" method="POST" class="form-grid">
                    <div class="form-group">
                        <label>Campanha</label>
                        <select name="campaign_id" required>
                            <option value="">Selecione</option>
                            <% campaigns.forEach(campaign=> { %>
                                <option value="<%= campaign.id %>">
                                    <%= campaign.season_name %> • <%= campaign.club_name %> • <%=
                                                campaign.competition_name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Jogos</label>
                        <input type="number" name="games" min="0" value="0">
                    </div>

                    <div class="form-group">
                        <label>Gols</label>
                        <input type="number" name="goals" min="0" value="0">
                    </div>

                    <div class="form-group">
                        <label>Assistências</label>
                        <input type="number" name="assists" min="0" value="0">
                    </div>

                    <div class="form-group">
                        <label>Amarelos</label>
                        <input type="number" name="yellow_cards" min="0" value="0">
                    </div>

                    <div class="form-group">
                        <label>2º Amarelo</label>
                        <input type="number" name="second_yellow_cards" min="0" value="0">
                    </div>

                    <div class="form-group">
                        <label>Vermelhos</label>
                        <input type="number" name="red_cards" min="0" value="0">
                    </div>

                    <div class="form-group">
                        <label>Nota Média</label>
                        <input type="number" name="average_rating" min="0" max="10" step="0.01">
                    </div>

                    <div class="form-group">
                        <label>Artilheiro?</label>
                        <select name="top_scorer">
                            <option value="">Não</option>
                            <option value="1">Sim</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Garçom?</label>
                        <select name="top_assister">
                            <option value="">Não</option>
                            <option value="1">Sim</option>
                        </select>
                    </div>

                    <button type="submit" class="btn-primary">Adicionar</button>
                </form>
            </section>

            <section class="table-card">
                <h2>Estatísticas cadastradas</h2>

                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Temporada</th>
                            <th>Clube</th>
                            <th>Competição</th>
                            <th>J</th>
                            <th>G</th>
                            <th>A</th>
                            <th>CA</th>
                            <th>2CA</th>
                            <th>CV</th>
                            <th>Nota</th>
                            <th>Artilheiro</th>
                            <th>Garçom</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% stats.forEach(stat=> { %>
                            <tr>
                                <td>
                                    <%= stat.season_name %>
                                </td>
                                <td>
                                    <%= stat.club_name %>
                                </td>
                                <td>
                                    <%= stat.competition_name %>
                                </td>
                                <td>
                                    <%= stat.games %>
                                </td>
                                <td>
                                    <%= stat.goals %>
                                </td>
                                <td>
                                    <%= stat.assists %>
                                </td>
                                <td>
                                    <%= stat.yellow_cards %>
                                </td>
                                <td>
                                    <%= stat.second_yellow_cards %>
                                </td>
                                <td>
                                    <%= stat.red_cards %>
                                </td>
                                <td>
                                    <%= stat.average_rating || '-' %>
                                </td>
                                <td>
                                    <%= stat.top_scorer ? 'Sim' : 'Não' %>
                                </td>
                                <td>
                                    <%= stat.top_assister ? 'Sim' : 'Não' %>
                                </td>

                                <td class="actions-cell">
                                    <a class="btn-small" href="/gerenciar/estatisticas/editar/<%= stat.id %>">Editar</a>

                                    <form action="/gerenciar/estatisticas/excluir/<%= stat.id %>" method="POST"
                                        onsubmit="return confirm('Excluir esta estatística?')">
                                        <button type="submit" class="btn-danger">Excluir</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </section>
        </main>

        <%- include('partials/footer') %>