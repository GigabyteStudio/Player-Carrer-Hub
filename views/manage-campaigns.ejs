<%- include('partials/header', { title }) %>
    <%- include('partials/navbar') %>

        <main class="container">
            <section class="page-header">
                <h1>Campeonatos</h1>
                <p>Registre as campanhas disputadas por temporada, clube e competição.</p>
            </section>

            <section class="form-card">
                <h2>Adicionar Campeonato</h2>

                <form action="/gerenciar/campeonatos/adicionar" method="POST" class="form-grid">
                    <div class="form-group">
                        <label>Temporada</label>
                        <select name="season_id" required>
                            <option value="">Selecione</option>
                            <% seasons.forEach(season=> { %>
                                <option value="<%= season.id %>">
                                    <%= season.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Time</label>
                        <select name="club_id" required>
                            <option value="">Selecione</option>
                            <% clubs.forEach(club=> { %>
                                <option value="<%= club.id %>">
                                    <%= club.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Competição</label>
                        <select name="competition_id" required>
                            <option value="">Selecione</option>
                            <% competitions.forEach(competition=> { %>
                                <option value="<%= competition.id %>">
                                    <%= competition.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Posição Final</label>
                        <input type="text" name="final_position" placeholder="Campeão, Vice, 3º, Em andamento...">
                    </div>

                    <button type="submit" class="btn-primary">Adicionar</button>
                </form>
            </section>

            <section class="table-card">
                <h2>Campeonatos cadastrados</h2>

                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Temporada</th>
                            <th>Time</th>
                            <th>Competição</th>
                            <th>Categoria</th>
                            <th>Posição</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% campaigns.forEach(campaign=> { %>
                            <tr>
                                <td>
                                    <%= campaign.season_name %>
                                </td>
                                <td>
                                    <%= campaign.club_name %>
                                </td>
                                <td>
                                    <%= campaign.competition_name %>
                                </td>
                                <td><span class="badge">
                                        <%= campaign.competition_category || '-' %>
                                    </span></td>
                                <td>
                                    <%= campaign.final_position || '-' %>
                                </td>

                                <td class="actions-cell">
                                    <a class="btn-small"
                                        href="/gerenciar/campeonatos/editar/<%= campaign.id %>">Editar</a>

                                    <form action="/gerenciar/campeonatos/excluir/<%= campaign.id %>" method="POST"
                                        onsubmit="return confirm('Excluir este campeonato?')">
                                        <button type="submit" class="btn-danger">Excluir</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </section>
        </main>

        <%- include('partials/footer') %>