<%- include('partials/header', { title }) %>
    <%- include('partials/navbar') %>

        <main class="container">
            <section class="page-header">
                <h1>Editar Transferência</h1>
                <p>Altere os dados da transferência.</p>
            </section>

            <section class="form-card">
                <form action="/gerenciar/transferencias/editar/<%= transfer.id %>" method="POST" class="form-grid">
                    <div class="form-group">
                        <label>Temporada</label>
                        <select name="season_id" required>
                            <% seasons.forEach(season=> { %>
                                <option value="<%= season.id %>" <%=transfer.season_id===season.id ? 'selected' : '' %>>
                                    <%= season.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Data</label>
                        <input type="date" name="date" value="<%= transfer.date %>" required>
                    </div>

                    <div class="form-group">
                        <label>Origem</label>
                        <select name="from_club_id">
                            <option value="">Sem clube / Início</option>
                            <% clubs.forEach(club=> { %>
                                <option value="<%= club.id %>" <%=transfer.from_club_id===club.id ? 'selected' : '' %>>
                                    <%= club.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Destino</label>
                        <select name="to_club_id" required>
                            <% clubs.forEach(club=> { %>
                                <option value="<%= club.id %>" <%=transfer.to_club_id===club.id ? 'selected' : '' %>>
                                    <%= club.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Valor de Mercado</label>
                        <input type="number" name="market_value" value="<%= transfer.market_value || '' %>" min="0">
                    </div>

                    <div class="form-group">
                        <label>Valor Pago</label>
                        <input type="number" name="transfer_fee" value="<%= transfer.transfer_fee || 0 %>" min="0">
                    </div>

                    <div class="form-group">
                        <label>Contrato até</label>
                        <input type="date" name="contract_until" value="<%= transfer.contract_until || '' %>">
                    </div>

                    <button type="submit" class="btn-primary">Salvar alterações</button>
                </form>
            </section>
        </main>

        <%- include('partials/footer') %>