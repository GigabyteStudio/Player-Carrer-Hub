<%- include('partials/header', { title }) %>
    <%- include('partials/navbar') %>

        <main class="container">
            <section class="page-header">
                <h1>Editar Clube/Seleção</h1>
                <p>Altere os dados do cadastro.</p>
            </section>

            <section class="form-card">
                <form action="/gerenciar/clubes/editar/<%= club.id %>" method="POST" enctype="multipart/form-data"
                    class="form-grid">
                    <div class="form-group">
                        <label>Nome</label>
                        <input type="text" name="name" value="<%= club.name %>" required>
                    </div>

                    <div class="form-group">
                        <label>Tipo</label>
                        <select name="type" required>
                            <option value="Clube" <%=club.type==='Clube' ? 'selected' : '' %>>Clube</option>
                            <option value="Seleção" <%=club.type==='Seleção' ? 'selected' : '' %>>Seleção</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Liga</label>
                        <select name="league_id">
                            <option value="">Nenhuma</option>
                            <% leagues.forEach(league=> { %>
                                <option value="<%= league.id %>" <%=club.league_id===league.id ? 'selected' : '' %>>
                                    <%= league.name %>
                                        <%= league.country_name ? `(${league.country_name})` : '' %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Escudo/Bandeira</label>
                        <% if (club.logo) { %>
                            <img src="<%= club.logo %>" class="table-logo">
                            <% } %>
                                <input type="hidden" name="current_logo" value="<%= club.logo || '' %>">
                                <input type="file" name="logo" accept="image/*">
                    </div>

                    <button type="submit" class="btn-primary">Salvar alterações</button>
                </form>
            </section>
        </main>

        <%- include('partials/footer') %>