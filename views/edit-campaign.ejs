<%- include('partials/header', { title }) %>
    <%- include('partials/navbar') %>

        <main class="container">
            <section class="page-header">
                <h1>Editar Campeonato</h1>
                <p>Altere os dados da campanha.</p>
            </section>

            <section class="form-card">
                <form action="/gerenciar/campeonatos/editar/<%= campaign.id %>" method="POST" class="form-grid">
                    <div class="form-group">
                        <label>Temporada</label>
                        <select name="season_id" required>
                            <% seasons.forEach(season=> { %>
                                <option value="<%= season.id %>" <%=campaign.season_id===season.id ? 'selected' : '' %>>
                                    <%= season.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Time</label>
                        <select name="club_id" required>
                            <% clubs.forEach(club=> { %>
                                <option value="<%= club.id %>" <%=campaign.club_id===club.id ? 'selected' : '' %>>
                                    <%= club.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Competição</label>
                        <select name="competition_id" required>
                            <% competitions.forEach(competition=> { %>
                                <option value="<%= competition.id %>" <%=campaign.competition_id===competition.id
                                    ? 'selected' : '' %>>
                                    <%= competition.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Posição Final</label>
                        <input type="text" name="final_position" value="<%= campaign.final_position || '' %>">
                    </div>

                    <button type="submit" class="btn-primary">Salvar alterações</button>
                </form>
            </section>
        </main>

        <%- include('partials/footer') %>