<%- include('partials/header', { title }) %>
    <%- include('partials/navbar') %>

        <main class="container">
            <section class="page-header">
                <h1>Editar País</h1>
                <p>Altere o nome ou a bandeira do país.</p>
            </section>

            <section class="form-card">
                <form action="/gerenciar/paises/editar/<%= country.id %>" method="POST" enctype="multipart/form-data"
                    class="form-grid">
                    <div class="form-group">
                        <label>Nome do País</label>
                        <input type="text" name="name" value="<%= country.name %>" required>
                    </div>

                    <div class="form-group">
                        <label>Bandeira atual</label>
                        <% if (country.flag) { %>
                            <img src="<%= country.flag %>" class="table-flag">
                            <% } else { %>
                                <span>-</span>
                                <% } %>
                    </div>

                    <div class="form-group">
                        <label>Nova bandeira</label>
                        <input type="hidden" name="current_flag" value="<%= country.flag || '' %>">
                        <input type="file" name="flag" accept="image/*">
                    </div>

                    <button type="submit" class="btn-primary">Salvar alterações</button>
                </form>
            </section>
        </main>

        <%- include('partials/footer') %>