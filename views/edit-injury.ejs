<%- include('partials/header', { title }) %>
    <%- include('partials/navbar') %>

        <main class="container">
            <section class="page-header">
                <h1>Editar Lesão</h1>
                <p>Altere os dados da lesão.</p>
            </section>

            <section class="form-card">
                <form action="/gerenciar/lesoes/editar/<%= injury.id %>" method="POST" class="form-grid">
                    <div class="form-group">
                        <label>Temporada</label>
                        <select name="season_id" required>
                            <% seasons.forEach(season=> { %>
                                <option value="<%= season.id %>" <%=injury.season_id===season.id ? 'selected' : '' %>>
                                    <%= season.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Nome da Lesão</label>
                        <input type="text" name="injury_name" value="<%= injury.injury_name %>" required>
                    </div>

                    <div class="form-group">
                        <label>Data da Lesão</label>
                        <input type="date" name="injury_date" value="<%= injury.injury_date || '' %>">
                    </div>

                    <div class="form-group">
                        <label>Dias Lesionado</label>
                        <input type="number" name="days_injured" value="<%= injury.days_injured || 0 %>" min="0">
                    </div>

                    <div class="form-group">
                        <label>Jogos Perdidos</label>
                        <input type="number" name="games_missed" value="<%= injury.games_missed || 0 %>" min="0">
                    </div>

                    <button type="submit" class="btn-primary">Salvar alterações</button>
                </form>
            </section>
        </main>

        <%- include('partials/footer') %>